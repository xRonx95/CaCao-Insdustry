# For local Supabase CLI / backend development only.
# Static browser configuration is assets/js/config.js, not this file.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
# Edge Function secrets must be configured in Supabase, never committed here:
# ALLOWED_ORIGIN=https://your-site.example
# SUPABASE_SERVICE_ROLE_KEY is supplied to hosted Edge Functions by Supabase.
